<?xml version="1.0" encoding="UTF-8"?>
<!-- Normal bundled component launches inject authoritative tunnels/half-width
     from config/scene_geometry.yaml. Literal geometry below is a compatibility
     fallback; editing it alone does not change normal dual/LIO/GT launches. -->
<!-- Keep the final task goal. Only verified, observed intermediate points are
     consumed by passage; ordinary replanning sees the remaining goal list. -->
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery" number_of_retries="3">
      <Sequence name="PreparePassageAndNavigateThroughPoses">
        <TunnelFinalGoal goals="{goals}" goal="{tunnel_goal}"/>
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        <TunnelPassage path="{path}" goal="{tunnel_goal}" goals="{goals}"
                       continuous_path="true" task_completed="{tunnel_task_completed}"
                       exit_spin_speed="0.0" keep_exit_spin_at_goal="false"
                       body_frame="chassis" control_frame="gimbal_yaw_fake"
                       use_sim_time="true" tunnels="-3.5;-1.5;3.475;1.5;3.5;-3.475"
                       entry_distance="0.5" exit_distance="0.6"
                       approach_speed="0.45" passage_speed="0.8"
                       approach_slowdown_distance="1.0" rolling_alignment_speed="0.45"
                       waiting_longitudinal_tolerance="0.30" rotation_speed="0.6"
                       controller_id="FollowPathTunnel" goal_checker_id="tunnel_goal_checker"/>
        <Fallback name="AlreadyCompletedOrOrdinaryNavigation">
          <TunnelTaskCompleted completed="{tunnel_task_completed}"/>
          <PipelineSequence name="NavigateWithReplanning">
            <RateController hz="3.0">
              <ReactiveSequence>
                <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"
                                   robot_base_frame="gimbal_yaw_fake"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              </ReactiveSequence>
            </RateController>
            <TunnelRouteGuard path="{path}" tunnels="-3.5;-1.5;3.475;1.5;3.5;-3.475"/>
            <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
          </PipelineSequence>
        </Fallback>
      </Sequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Wait wait_duration="1"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
