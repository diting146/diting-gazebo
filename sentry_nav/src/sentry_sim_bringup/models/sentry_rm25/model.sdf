			<joint_name>gimbal_yaw_joint</joint_name>
			<p_gain>50.0</p_gain>
			<i_gain>0.0</i_gain>
			<d_gain>5.0</d_gain>
			<i_max>10.0</i_max>
			<i_min>-10.0</i_min>
			<cmd_max>200.0</cmd_max>
			<cmd_min>-200.0</cmd_min>
			<initial_position>0.0</initial_position>
			<topic>/sentry_robot1/gimbal_yaw_cmd</topic>
		</plugin>
