<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_sim_bringup</name>
  <version>0.1.0</version>
  <description>
    Simulation bringup for a RM25-model sentry, including sensor bridges,
    sensor-only LIO navigation, mapping, and a simulated MCU velocity gateway.
  </description>
  <maintainer email="diting@example.com">diting</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rmu_gazebo_simulator</exec_depend>
  <exec_depend>pb2025_nav_bringup</exec_depend>
  <exec_depend>pb2025_robot_description</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>fake_vel_transform</exec_depend>
  <exec_depend>terrain_analysis</exec_depend>
  <exec_depend>terrain_analysis_ext</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>loam_interface</exec_depend>
  <exec_depend>sensor_scan_generation</exec_depend>
  <exec_depend>small_gicp_relocalization</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
