<?xml version="1.0"?>
<package format="2">
	<name>rmu_gazebo_simulator</name>
	<version>1.0.0</version>
	<description>rmu_gazebo_simulator - rm25 multi-robot simulation on the diting 3v3 arena with an HP-only referee</description>

	<maintainer email="lihanchen2004@163.com">Lihan Chen</maintainer>
	<license>Apache-2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>
	<buildtool_depend>ament_cmake_auto</buildtool_depend>

	<!-- Runtime dependencies only: this package installs launch/config/resource
	     and Python nodes; it compiles and links nothing, so nothing is needed at
	     build time (keeps the package buildable without the full rmoss stack). -->
	<exec_depend>ament_index_python</exec_depend>
	<exec_depend>launch</exec_depend>
	<exec_depend>launch_ros</exec_depend>
	<exec_depend>python3-yaml</exec_depend>

	<exec_depend>ros_gz_sim</exec_depend>
	<exec_depend>ros_gz_bridge</exec_depend>
	<exec_depend>rclpy</exec_depend>
	<exec_depend>std_msgs</exec_depend>
	<exec_depend>geometry_msgs</exec_depend>
	<exec_depend>nav2_msgs</exec_depend>

	<!-- Provides the MecanumDrive2 Gazebo plugin used by rm25_example_robot -->
	<exec_depend>rmoss_gz_plugins</exec_depend>

	<test_depend>ament_lint_auto</test_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
